{
  "name": "wa-crm-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.Fajar-HSE/wa-crm-mcp",
  "description": "Model Context Protocol (MCP) server for WA-CRM — drive your self-hosted WhatsApp CRM from Claude, Cursor, and other MCP clients.",
  "license": "MIT",
  "author": "Fajar-HSE",
  "homepage": "https://github.com/Fajar-HSE/WA-CRM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fajar-HSE/WA-CRM.git",
    "directory": "mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wa-crm",
    "whatsapp",
    "crm",
    "claude",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
